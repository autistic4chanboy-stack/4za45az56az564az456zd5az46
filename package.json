{
  "name": "rails-de-cendres",
  "private": true,
  "version": "1.0.0",
  "description": "Rails de Cendres — tower defense / rogue-like / exploration en 3D vue de dessus, aux commandes d'un train post-apocalyptique.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:artifact": "npm run build && node scripts/build-artifact.mjs",
    "build:pages": "npm run build && node scripts/build-pages.mjs"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "three": "0.186.1"
  }
}
